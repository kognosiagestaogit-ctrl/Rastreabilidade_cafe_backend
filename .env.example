# ==========================================
# Configurações do Banco de Dados (Docker + Drizzle)
# ==========================================
# Usado pelo docker-compose.prod.yml para subir o container do Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_segura_aqui
POSTGRES_DB=fazenda_pedra_negra

# Usado pela API e Drizzle para conectar ao banco
DATABASE_URL=postgres://postgres:sua_senha_segura_aqui@db:5432/fazenda_pedra_negra

# ==========================================
# Segurança e JWT
# ==========================================
JWT_SECRET=fazenda_pedra_negra_secret_key_change_in_production
CRON_SECRET=sua_chave_secreta_para_crons_aqui_com_mais_de_10_chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ==========================================
# Servidor e URLs
# ==========================================
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
